{
  "name": "license-management-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "持证上岗统计分析系统 Demo",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run tokens && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "verify:data": "node scripts/verify-data.mjs",
    "tokens": "node scripts/tokens.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "format": "prettier --write src tests scripts *.json *.ts *.md docs public/*.md",
    "format:check": "prettier --check src tests scripts *.json *.ts *.md docs public/*.md",
    "verify:pages": "node scripts/verify-pages.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.6"
  }
}
